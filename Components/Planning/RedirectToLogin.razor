@inject NavigationManager Navigation

@* Interactive navigation to a protected page: go to the login form (full page load, so the cookie is set by HTTP). *@
<p class="text-muted">Login required…</p>

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"account/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
