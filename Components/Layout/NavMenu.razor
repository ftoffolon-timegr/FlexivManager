@inject FlexivManager.Hosting.HostRole Role

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="img/logo-time.png" alt="TIME" class="brand-logo" />
            FlexivManager
        </a>
    </div>
</div>

<input type="checkbox" title="Menu di navigazione" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        @* Planning pages live on the monitoring host (remote). Reading is open;
           the pages themselves ask for login before editing. *@
        @if (Role.CanEdit)
        {
        @*     <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-house" aria-hidden="true"></i> Home
                </NavLink>
            </div> *@

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="robot">
                    <i class="bi bi-robot" aria-hidden="true"></i> Stato robot
                </NavLink>
            </div>
        }

        @* The operator panel exists only on the operator host (localhost). *@
        @if (Role.CanCommand)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="operator">
                    <i class="bi bi-joystick" aria-hidden="true"></i> Operatore
                </NavLink>
            </div>
        }

        @* Planning pages live on the monitoring host (remote). Reading is open;
           the pages themselves ask for login before editing. *@
        @if (Role.CanEdit)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="plans">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i> Plan del robot
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="jobs">
                    <i class="bi bi-card-checklist" aria-hidden="true"></i> Codici lavoro
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="orders">
                    <i class="bi bi-calendar-check" aria-hidden="true"></i> Ordini di produzione
                </NavLink>
            </div>
        }
    </nav>
</div>
