@page "/operator"
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject SnapshotStore Store
@inject IPlanningReader Planning
@inject TimeProvider Time

<PageTitle>Operator</PageTitle>

<h1>Operator</h1>

@if (_commands is null)
{
    <div class="alert alert-info">
        <i class="bi bi-eye" aria-hidden="true"></i>
        Remote station: jobs are started only from the local operator station.
    </div>
}

@{
    var s = _snapshot;
    var running = s.ActiveCycle is not null;
    var canCommand = _commands is not null && !_busy;
    // One order in progress at a time: it must be completed or cancelled before another one starts.
    var activeOrder = _orders.FirstOrDefault(o => o.Status == OrderStatus.Active);
}

<div class="operator-grid">
    @* ---- Selection: barcode / work list / one-off ---- *@
    <section class="card">
        <div class="card-header"><i class="bi bi-upc-scan" aria-hidden="true"></i> Product code</div>
        <div class="card-body">
            @if (_commands is not null)
            {
                <form class="mb-2" @onsubmit="OnScanSubmitAsync">
                    <label class="form-label small text-muted" for="scan">Scan the barcode (or type the code and press Enter)</label>
                    <input id="scan" class="form-control form-control-lg" autocomplete="off" spellcheck="false"
                           @ref="_scanInput" @bind="_scanText" @bind:event="oninput"
                           placeholder="@(running ? "cycle running: scanning disabled" : "waiting for barcode…")" />
                </form>
            }
            @if (_scanMessage is not null)
            {
                <div class="small @(_scanOk ? "text-success" : "text-danger")">@_scanMessage</div>
            }

            @if (_commands is not null)
            {
                <div class="input-group input-group-sm mt-3">
                    <label class="input-group-text" for="manual">One-off job</label>
                    <select id="manual" class="form-select" @bind="_manualCode">
                        <option value="">-- choose code --</option>
                        @foreach (var job in _jobs.Where(j => j.Enabled))
                        {
                            var jobOnRobot = s.AvailablePlans.Contains(job.PlanName);
                            <option value="@job.ProductCode" disabled="@(!jobOnRobot)">@job.ProductCode → @job.PlanName@(jobOnRobot ? "" : " (plan not on robot)")</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary" disabled="@(running || activeOrder is not null || string.IsNullOrEmpty(_manualCode))" @onclick="SelectManualAsync">Load</button>
                </div>
            }
        </div>
    </section>

    @* ---- Selected job ---- *@
    <section class="card">
        <div class="card-header"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Selected</div>
        <div class="card-body">
            @if (_selectedJob is null)
            {
                <p class="text-muted mb-0">@(_selectionError ?? "Nothing selected: scan a code or choose an order.")</p>
            }
            else
            {
                var job = _selectedJob;
                var onRobot = s.AvailablePlans.Contains(job.PlanName);
                <dl class="row mb-2">
                    @if (_selectedOrder is { } order)
                    {
                        <dt class="col-4">Order</dt><dd class="col-8 fw-semibold">@order.OrderNumber</dd>
                        <dt class="col-4">Progress</dt><dd class="col-8">@order.CompletedCount / @order.Quantity <span class="text-muted">(remaining @order.Remaining)</span></dd>
                        @if (!string.IsNullOrEmpty(order.Notes))
                        {
                            <dt class="col-4">Notes</dt><dd class="col-8 small">@order.Notes</dd>
                        }
                    }
                    else
                    {
                        <dt class="col-4">Order</dt><dd class="col-8"><span class="badge text-bg-secondary">one-off</span></dd>
                    }
                    <dt class="col-4">Code</dt><dd class="col-8">@job.ProductCode</dd>
                    <dt class="col-4">Plan</dt>
                    <dd class="col-8">
                        <code>@job.PlanName</code>
                        @if (!onRobot)
                        {
                            <span class="badge text-bg-warning ms-1">not on robot</span>
                        }
                    </dd>
                    <dt class="col-4">Velocity</dt><dd class="col-8">@job.VelocityScale %</dd>
                    @if (!string.IsNullOrEmpty(job.Description))
                    {
                        <dt class="col-4">Description</dt><dd class="col-8 small">@job.Description</dd>
                    }
                </dl>
                @if (_commands is not null)
                {
                    var repeat = _selectedOrder is { } o && _commands.CanRepeatWithoutConfirmation(o.Id);
                    <button class="btn btn-lg btn-primary w-100" disabled="@(!canCommand || running || !onRobot || s.State != RobotServiceState.Operational)"
                            @onclick="StartAsync">
                        <i class="bi bi-play-circle-fill" aria-hidden="true"></i> @(repeat ? "Start next cycle" : "Start…")
                    </button>
                    @if (!onRobot)
                    {
                        <div class="small text-danger mt-1">
                            Plan <code>@job.PlanName</code> is not stored on this robot: start is disabled.
                            Associate the code with an existing plan on the remote planning station.
                        </div>
                    }
                    @if (s.State != RobotServiceState.Operational && !running)
                    {
                        <div class="small text-muted mt-1">Start requires OPERATIONAL (now @RobotStateStyle.Label(s.State)).</div>
                    }
                }
            }
            @if (_lastResult is not null)
            {
                <div class="small mt-2 @(_lastResultOk ? "text-success" : "text-danger")">@_lastResult</div>
            }
        </div>
    </section>

    @* ---- Execution ---- *@
    <section class="card">
        <div class="card-header"><i class="bi bi-activity" aria-hidden="true"></i> Execution</div>
        <div class="card-body">
            <p class="mb-2">
                <span class="badge fs-6 @RobotStateStyle.BadgeClass(s.State)">@RobotStateStyle.Label(s.State)</span>
                <span class="text-muted small ms-2">@s.Status.OperationalStatus · mode @s.Status.Mode</span>
            </p>
            @if (s.ActiveCycle is { } cycle)
            {
                <dl class="row mb-2">
                    <dt class="col-4">Order</dt><dd class="col-8">@(cycle.OrderNumber ?? "one-off")</dd>
                    <dt class="col-4">Code</dt><dd class="col-8">@cycle.ProductCode</dd>
                    <dt class="col-4">Plan</dt><dd class="col-8"><code>@cycle.PlanName</code> @@ @cycle.VelocityScale %</dd>
                    <dt class="col-4">Node</dt><dd class="col-8">@(string.IsNullOrEmpty(s.Plan?.NodeName) ? "-" : s.Plan.NodeName)</dd>
                    <dt class="col-4">Elapsed</dt><dd class="col-8">@((Time.GetUtcNow() - cycle.StartedAt).TotalSeconds.ToString("0.0")) s</dd>
                </dl>
            }
            else if (s.LastCycle is { } last)
            {
                <div class="alert @(last.Outcome == CycleOutcome.Completed ? "alert-success" : "alert-warning") py-2 small">
                    Last cycle @last.Outcome: <code>@last.PlanName</code> (@(last.OrderNumber ?? "one-off")), @last.Duration.TotalSeconds.ToString("0.0") s
                    @if (last.Message is not null)
                    {
                        <span> - @last.Message</span>
                    }
                    @if (last.Outcome != CycleOutcome.Completed)
                    {
                        <div>Not counted. Fix the cause, then press Start again.</div>
                    }
                </div>
            }
            <p class="small text-muted mb-2">Cycles completed since start: @s.CompletedCycles</p>
            @if (_commands is not null)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-outline-warning" disabled="@(!canCommand || !Allowed(new PausePlanCommand()))"
                            @onclick="() => Run(c => c.PausePlanAsync(Source))">
                        <i class="bi bi-pause-fill" aria-hidden="true"></i> Pause
                    </button>
                    <button class="btn btn-outline-primary" disabled="@(!canCommand || !Allowed(new ResumePlanCommand()))"
                            @onclick="RequestResume">
                        <i class="bi bi-play-fill" aria-hidden="true"></i> Resume…
                    </button>
                    <button class="btn btn-outline-danger" disabled="@(!canCommand || !Allowed(new StopPlanCommand()))"
                            @onclick="() => Run(c => c.StopPlanAsync(Source))">
                        <i class="bi bi-skip-end-fill" aria-hidden="true"></i> Stop
                    </button>
                    <StopButton Source="operator-page" />
                </div>
                <hr />
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(!canCommand || !Allowed(new ConnectCommand()))"
                            @onclick="() => Run(c => c.ConnectAsync(Source))">
                        <i class="bi bi-plug" aria-hidden="true"></i> Connect
                    </button>
                    <button class="btn btn-sm btn-outline-success" disabled="@(!canCommand || !Allowed(new EnableCommand()))"
                            @onclick="() => Run(c => c.EnableAsync(Source))">
                        <i class="bi bi-power" aria-hidden="true"></i> Enable
                    </button>
                    <button class="btn btn-sm btn-outline-warning" disabled="@(!canCommand || !Allowed(new ClearFaultCommand()))"
                            @onclick="() => Run(c => c.ClearFaultAsync(Source))">
                        <i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Clear fault
                    </button>
                </div>
            }
            @if (s.LastError is not null)
            {
                <div class="alert alert-warning py-1 small mt-2 mb-0">@s.LastError</div>
            }
        </div>
    </section>

    @* ---- Work list ---- *@
    <section class="card worklist">
        <div class="card-header"><i class="bi bi-list-ol" aria-hidden="true"></i> Work list</div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>#</th><th>Order</th><th>Code</th><th>Done</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < _orders.Count; i++)
                    {
                        var o = _orders[i];
                        var selected = _selectedOrder?.Id == o.Id;
                        <tr class="@(selected ? "table-active" : "")">
                            <td>@(i + 1)</td>
                            <td class="fw-semibold">@o.OrderNumber @if (i == 0) {<span class="badge text-bg-info ms-1">current</span>}</td>
                            <td>
                                @o.ProductCode
                                @{
                                    var orderJob = _jobs.FirstOrDefault(j => j.ProductCode == o.ProductCode);
                                }
                                @if (orderJob is null)
                                {
                                    <span class="badge text-bg-danger ms-1">no job</span>
                                }
                                else if (!s.AvailablePlans.Contains(orderJob.PlanName))
                                {
                                    <span class="badge text-bg-warning ms-1" title="Plan @orderJob.PlanName is not stored on the robot">plan not on robot</span>
                                }
                            </td>
                            <td>@o.CompletedCount / @o.Quantity</td>
                            <td>@o.Status</td>
                            <td class="text-end">
                                @if (_commands is not null && !selected)
                                {
                                    var blocked = activeOrder is not null && activeOrder.Id != o.Id;
                                    <button class="btn btn-sm btn-outline-primary" disabled="@(running || blocked)"
                                            title="@(blocked ? $"Order {activeOrder!.OrderNumber} is in progress" : null)"
                                            @onclick="() => SelectOrderAsync(o)">Select</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_orders.Count == 0)
        {
            <p class="text-muted small m-2">No open orders. Scan a code to run a one-off job.</p>
        }
        else if (activeOrder is not null)
        {
            <p class="text-muted small m-2">Order @activeOrder.OrderNumber is in progress: other orders and one-off jobs can start once it is completed or cancelled.</p>
        }
    </section>
</div>

@* ---- Motion confirmation dialog (in-page, no JS confirm()) ---- *@
@if (_pending is not null)
{
    var remaining = _pending.ExpiresAt - Time.GetUtcNow();
    var expired = remaining <= TimeSpan.Zero;
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-warning">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirm-title">
                        <i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i> Confirm robot motion
                    </h5>
                </div>
                <div class="modal-body">
                    <p class="fw-semibold">@_pending.Summary</p>
                    <p class="small mb-1">The robot will move. Check that the work cell is clear and the hardware emergency stop is within reach.</p>
                    <p class="small text-muted mb-0">
                        @(expired ? "Confirmation expired: close and request again." : $"Expires in {Math.Ceiling(remaining.TotalSeconds):0} s.")
                    </p>
                </div>
                <div class="modal-footer justify-content-between">
                    @* STOP stays reachable while the dialog covers the page. *@
                    <StopButton Source="operator-confirm-dialog" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary" @onclick="CancelPending">Cancel</button>
                        <button class="btn btn-warning" disabled="@(expired || _busy)" @onclick="ConfirmPending">
                            <i class="bi bi-play-fill" aria-hidden="true"></i> Confirm and move
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private const string Source = "operator-page";
    private static readonly TimeSpan RefreshPeriod = TimeSpan.FromMilliseconds(200);

    private RobotCommandService? _commands;
    private ScanService? _scanner;
    private RobotSnapshot _snapshot = RobotSnapshot.Initial;
    private IReadOnlyList<ProductionOrder> _orders = [];
    private IReadOnlyList<Job> _jobs = [];

    // Selection: explicit order, explicit one-off code, or (default) the current order.
    private int? _explicitOrderId;
    private string? _oneOffCode;
    private ProductionOrder? _selectedOrder;
    private Job? _selectedJob;
    private string? _selectionError;

    private ElementReference _scanInput;
    private string _scanText = "";
    private string? _scanMessage;
    private bool _scanOk;
    private bool _focusScan = true;
    private string _manualCode = "";

    private ConfirmationRequest? _pending;
    private bool _busy;
    private string? _lastResult;
    private bool _lastResultOk;
    private readonly CancellationTokenSource _cts = new();
    private Task? _refreshLoop;
    private int _tick;

    protected override async Task OnInitializedAsync()
    {
        _commands = Services.GetService<RobotCommandService>();
        _scanner = Services.GetService<ScanService>();
        _snapshot = Store.Current;
        await LoadPlanningAsync();
        _refreshLoop = RefreshLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Keyboard-wedge scanners type into the focused field: keep the scan box focused when idle.
        if (_focusScan && _commands is not null && _pending is null)
        {
            _focusScan = false;
            try { await _scanInput.FocusAsync(); }
            catch (Exception) { /* element not rendered yet */ }
        }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(RefreshPeriod);
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                var current = Store.Current;
                var cycleEnded = _snapshot.ActiveCycle is not null && current.ActiveCycle is null;
                var changed = current.Sequence != _snapshot.Sequence;
                _snapshot = current;
                // Planning data changes on the remote host and after each cycle: reload once a second.
                if (cycleEnded || ++_tick % 5 == 0)
                {
                    await LoadPlanningAsync();
                    _focusScan |= cycleEnded;
                }
                if (changed || _pending is not null)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadPlanningAsync()
    {
        _orders = await Planning.ListOpenOrdersAsync(_cts.Token);
        _jobs = await Planning.ListJobsAsync(_cts.Token);
        await ResolveSelectionAsync();
    }

    /// <summary>Re-reads the selected order and its job (both may have been edited remotely).</summary>
    private async Task ResolveSelectionAsync()
    {
        _selectionError = null;
        // One order in progress at a time: while it is Active it is always the selection.
        if (_orders.FirstOrDefault(o => o.Status == OrderStatus.Active) is { } active)
            (_explicitOrderId, _oneOffCode) = (active.Id, null);
        if (_oneOffCode is { } code)
        {
            _selectedOrder = null;
            _selectedJob = _jobs.FirstOrDefault(j => j.ProductCode == code && j.Enabled);
            if (_selectedJob is null)
                (_oneOffCode, _selectionError) = (null, $"Job '{code}' is no longer available.");
            return;
        }

        var order = _explicitOrderId is { } id ? _orders.FirstOrDefault(o => o.Id == id) : null;
        if (order is null)
        {
            _explicitOrderId = null; // completed/cancelled meanwhile: fall back to the current order
            order = _orders.FirstOrDefault();
        }
        _selectedOrder = order;
        _selectedJob = order is null ? null : _jobs.FirstOrDefault(j => j.ProductCode == order.ProductCode);
        if (order is not null && _selectedJob is not { Enabled: true })
        {
            _selectionError = $"Order {order.OrderNumber}: job '{order.ProductCode}' is missing or disabled.";
            _selectedJob = null;
        }
    }

    private async Task OnScanSubmitAsync()
    {
        var raw = _scanText;
        _scanText = "";
        _focusScan = true;
        if (string.IsNullOrWhiteSpace(raw) || _scanner is null) return;

        if (_snapshot.ActiveCycle is not null || _pending is not null)
        {
            _scanner.LogIgnored(raw, "a cycle is running or awaiting confirmation", Source);
            (_scanOk, _scanMessage) = (false, "Ignored: a cycle is running.");
            return;
        }

        var result = await _scanner.ResolveAsync(raw, Source);
        if (!result.IsValid)
        {
            (_scanOk, _scanMessage) = (false, result.Error);
            return;
        }
        if (result.Order is { } order)
        {
            (_explicitOrderId, _oneOffCode) = (order.Id, null);
            (_scanOk, _scanMessage) = (true, $"'{result.Code}': order {order.OrderNumber} selected.");
        }
        else
        {
            (_explicitOrderId, _oneOffCode) = (null, result.Code);
            (_scanOk, _scanMessage) = (true, $"'{result.Code}': no open order, one-off job loaded.");
        }
        await LoadPlanningAsync();
    }

    private async Task SelectOrderAsync(ProductionOrder order)
    {
        (_explicitOrderId, _oneOffCode, _scanMessage) = (order.Id, null, null);
        _focusScan = true;
        await ResolveSelectionAsync();
    }

    private async Task SelectManualAsync()
    {
        if (_scanner is null || string.IsNullOrEmpty(_manualCode)) return;
        var result = await _scanner.ResolveAsync(_manualCode, Source + "/manual");
        if (result.IsValid)
            (_explicitOrderId, _oneOffCode, _scanOk, _scanMessage) = (null, result.Code, true, $"'{result.Code}': one-off job loaded.");
        else
            (_scanOk, _scanMessage) = (false, result.Error);
        _manualCode = "";
        _focusScan = true;
        await ResolveSelectionAsync();
    }

    private bool Allowed(RobotCommand command) => CommandPolicy.Check(_snapshot.State, command) is null;

    private async Task StartAsync()
    {
        if (_commands is null || _selectedJob is null) return;
        _busy = true;
        try
        {
            if (_selectedOrder is { } order && _commands.CanRepeatWithoutConfirmation(order.Id))
            {
                Show(await _commands.StartNextCycleAsync(order.Id, Source));
                return;
            }
            var request = await _commands.RequestStartAsync(_selectedJob.ProductCode, _selectedOrder?.Id, Source);
            if (request.IsAccepted)
                _pending = request;
            else
                Show(CommandResult.Rejected(request.Rejection!));
        }
        finally
        {
            _busy = false;
            _focusScan = _pending is null;
        }
    }

    private void RequestResume()
    {
        if (_commands is null) return;
        var request = _commands.RequestResume(Source);
        if (request.IsAccepted)
            _pending = request;
        else
            Show(CommandResult.Rejected(request.Rejection!));
    }

    private async Task Run(Func<RobotCommandService, Task<CommandResult>> action)
    {
        if (_commands is null) return;
        _busy = true;
        try { Show(await action(_commands)); }
        finally
        {
            _busy = false;
            _focusScan = true; // a clicked button took the focus: give it back to the scanner
        }
    }

    private async Task ConfirmPending()
    {
        if (_commands is null || _pending?.Token is not { } token) return;
        _busy = true;
        try
        {
            _pending = null;
            Show(await _commands.ConfirmAsync(token, Source));
        }
        finally
        {
            _busy = false;
            _focusScan = true;
        }
    }

    private void CancelPending()
    {
        if (_pending?.Token is { } token)
            _commands?.CancelConfirmation(token, Source);
        _pending = null;
        _focusScan = true;
    }

    private void Show(CommandResult result)
    {
        _lastResultOk = result.IsSuccess;
        _lastResult = result.IsSuccess ? "Command accepted." : $"{result.Outcome}: {result.Message}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_pending?.Token is { } token)
            _commands?.CancelConfirmation(token, Source);
        _cts.Cancel();
        if (_refreshLoop is not null)
            await _refreshLoop;
        _cts.Dispose();
    }
}
