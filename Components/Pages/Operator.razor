@page "/operator"
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject SnapshotStore Store
@inject IPlanningReader Planning
@inject TimeProvider Time

<PageTitle>Operatore</PageTitle>

@if (_commands is null)
{
    <div class="alert alert-info">
        <i class="bi bi-eye" aria-hidden="true"></i>
        Postazione remota: i lavori si avviano solo dalla postazione operatore locale.
    </div>
}

@{
    var s = _snapshot;
    var running = s.ActiveCycle is not null;
    var canCommand = _commands is not null && !_busy;
    var onRobot = _selectedJob is not null && s.AvailablePlans.Contains(_selectedJob.PlanName);
    var canStart = canCommand && !running && _selectedJob is not null && onRobot && s.State == RobotServiceState.Operational;
    var repeat = _selectedOrder is { } armed && _commands?.CanRepeatWithoutConfirmation(armed.Id) == true;
}

<div class="operator-layout">
    @* ---- Zone 1: product code (barcode scanner, keyboard for now) ---- *@
    <section class="card zone-code">
        <div class="card-header"><i class="bi bi-upc-scan" aria-hidden="true"></i> Codice prodotto</div>
        <div class="card-body">
            @if (_commands is not null)
            {
                <form class="mb-3" @onsubmit="OnScanSubmitAsync">
                    <label class="form-label small text-muted" for="scan">Leggi il barcode (oppure scrivi il codice e premi Invio)</label>
                    <input id="scan" class="form-control form-control-lg" autocomplete="off" spellcheck="false"
                           @ref="_scanInput" @bind="_scanText" @bind:event="oninput" disabled="@running"
                           placeholder="@(running ? "ciclo in corso: lettura disattivata" : "in attesa del barcode…")" />
                </form>
            }

            @if (_selectedJob is null)
            {
                <p class="text-muted mb-0">@(_selectionMessage ?? "Nessun codice selezionato: leggi un codice degli ordini di oggi.")</p>
            }
            else
            {
                var job = _selectedJob;
                <div class="selected-code">@job.ProductCode</div>
                <dl class="row mb-0 mt-2">
                    @if (_selectedOrder is { } order)
                    {
                        @if (order.OrderNumber.Length > 0)
                        {
                            <dt class="col-4">N. ordine</dt><dd class="col-8 fw-semibold">@order.OrderNumber</dd>
                        }
                        <dt class="col-4">Fatti</dt><dd class="col-8">@order.CompletedCount / @order.Quantity <span class="text-muted">(mancano @order.Remaining)</span></dd>
                        @if (!string.IsNullOrEmpty(order.Notes))
                        {
                            <dt class="col-4">Note</dt><dd class="col-8 small">@order.Notes</dd>
                        }
                    }
                    else
                    {
                        <dt class="col-4">Tipo</dt><dd class="col-8"><span class="badge text-bg-secondary">servizio (non conteggiato)</span></dd>
                    }
                    <dt class="col-4">Plan</dt>
                    <dd class="col-8">
                        <code>@job.PlanName</code>
                        @if (!onRobot)
                        {
                            <span class="badge text-bg-warning ms-1">non presente sul robot</span>
                        }
                    </dd>
                    @if (!string.IsNullOrEmpty(job.Description))
                    {
                        <dt class="col-4">Descrizione</dt><dd class="col-8 small">@job.Description</dd>
                    }
                </dl>
            }
        </div>
    </section>

    @* ---- Zone 2: START / STOP ---- *@
    <section class="card zone-controls">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi bi-activity" aria-hidden="true"></i> Lavorazione
            <span class="badge ms-auto @RobotStateStyle.BadgeClass(s.State)">@RobotStateStyle.Label(s.State)</span>
        </div>
        <div class="card-body">
            @if (_commands is not null)
            {
                <div class="control-buttons">
                    <button class="btn btn-success btn-xl" disabled="@(!canStart)" @onclick="StartAsync">
                        <i class="bi bi-play-fill" aria-hidden="true"></i> START
                    </button>
                    @* Software STOP: highest priority, always enabled. Does NOT replace the hardware emergency stop. *@
                    <button class="btn btn-danger btn-xl" @onclick="StopAsync">
                        <i class="bi bi-stop-fill" aria-hidden="true"></i> STOP
                    </button>
                </div>
                <div class="small text-muted mt-2">@StartHint(s, running, onRobot, repeat)</div>
            }

            @if (s.ActiveCycle is { } cycle)
            {
                <div class="alert alert-primary py-2 mt-3 mb-0">
                    In esecuzione <b>@cycle.ProductCode</b> · <code>@cycle.PlanName</code>
                    · @((Time.GetUtcNow() - cycle.StartedAt).TotalSeconds.ToString("0")) s
                    @if (!string.IsNullOrEmpty(s.Plan?.NodeName))
                    {
                        <span class="text-muted"> · @s.Plan.NodeName</span>
                    }
                </div>
            }
            else if (s.LastCycle is { } last)
            {
                <div class="alert @(last.Outcome == CycleOutcome.Completed ? "alert-success" : "alert-warning") py-2 mt-3 mb-0 small">
                    Ultimo ciclo @UiLabels.CycleOutcomeLabel(last.Outcome): <b>@last.ProductCode</b>, @last.Duration.TotalSeconds.ToString("0") s
                    @if (last.Message is not null)
                    {
                        <span> - @last.Message</span>
                    }
                    @if (last.Outcome != CycleOutcome.Completed)
                    {
                        <div>Non conteggiato. Elimina la causa, poi premi di nuovo START.</div>
                    }
                </div>
            }
            @if (_lastResult is not null)
            {
                <div class="small mt-2 @(_lastResultOk ? "text-success" : "text-danger")">@_lastResult</div>
            }
            @if (s.LastError is not null)
            {
                <div class="alert alert-warning py-1 small mt-2 mb-0">@s.LastError</div>
            }

            @if (_commands is not null)
            {
                @* Robot service: needed after power-on or a fault, not during normal work. *@
                <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(!canCommand || !Allowed(new ConnectCommand()))"
                            @onclick="() => Run(c => c.ConnectAsync(Source))">
                        <i class="bi bi-plug" aria-hidden="true"></i> Connetti
                    </button>
                    <button class="btn btn-sm btn-outline-success" disabled="@(!canCommand || !Allowed(new EnableCommand()))"
                            @onclick="() => Run(c => c.EnableAsync(Source))">
                        <i class="bi bi-power" aria-hidden="true"></i> Abilita
                    </button>
                    <button class="btn btn-sm btn-outline-warning" disabled="@(!canCommand || !Allowed(new ClearFaultCommand()))"
                            @onclick="() => Run(c => c.ClearFaultAsync(Source))">
                        <i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Reset anomalia
                    </button>
                    <span class="small text-muted ms-auto align-self-center">Cicli dall'avvio: @s.CompletedCycles</span>
                </div>
            }
        </div>
    </section>

    @* ---- Zone 3: today's work plan, done and to do (read-only) ---- *@
    <section class="card zone-plan">
        <div class="card-header d-flex">
            <span><i class="bi bi-list-ol" aria-hidden="true"></i> Ordini di produzione di oggi (@_today.ToString("dd/MM/yyyy"))</span>
            @if (_orders.Count > 0)
            {
                <span class="ms-auto small">
                    fatti @_orders.Sum(o => Math.Min(o.CompletedCount, o.Quantity)) / @_orders.Sum(o => o.Quantity) pezzi
                </span>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>#</th><th>Codice</th><th>N. ordine</th><th>Fatti</th><th>Stato</th></tr></thead>
                <tbody>
                    @for (var i = 0; i < _orders.Count; i++)
                    {
                        var o = _orders[i];
                        var selected = _selectedOrder?.Id == o.Id;
                        <tr class="@(selected ? "table-active" : "") @(o.IsOpen ? "" : "text-muted")">
                            <td>@(i + 1)</td>
                            <td class="fw-semibold">
                                @o.ProductCode
                                @if (selected)
                                {
                                    <i class="bi bi-caret-left-fill text-primary ms-1" title="Selezionato" aria-hidden="true"></i>
                                }
                                @{
                                    var orderJob = _jobs.FirstOrDefault(j => j.ProductCode == o.ProductCode);
                                }
                                @if (o.IsOpen && orderJob is null)
                                {
                                    <span class="badge text-bg-danger ms-1">codice non configurato</span>
                                }
                                else if (o.IsOpen && !s.AvailablePlans.Contains(orderJob!.PlanName))
                                {
                                    <span class="badge text-bg-warning ms-1" title="Il plan @(orderJob!.PlanName) non è salvato sul robot">plan non presente sul robot</span>
                                }
                            </td>
                            <td>@o.OrderNumber</td>
                            <td>@o.CompletedCount / @o.Quantity</td>
                            <td><span class="badge @StatusClass(o.Status)">@StatusLabel(o.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_orders.Count == 0)
        {
            <p class="text-muted small m-2">Nessun ordine di produzione per oggi. Gli ordini si impostano dalla postazione remota di pianificazione.</p>
        }
    </section>
</div>

@* ---- Warning popup: scanned code not accepted ---- *@
@if (_scanWarning is not null)
{
    <div class="modal d-block" tabindex="-1" role="alertdialog" aria-modal="true" aria-labelledby="scan-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger">
                <div class="modal-header">
                    <h5 class="modal-title" id="scan-title">
                        <i class="bi bi-exclamation-octagon-fill text-danger" aria-hidden="true"></i> Codice non accettato
                    </h5>
                </div>
                <div class="modal-body">
                    <p class="fs-5 mb-0">@_scanWarning</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary btn-lg" @ref="_warningOk" @onclick="CloseScanWarning">OK</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@* ---- Motion confirmation dialog (in-page, no JS confirm()) ---- *@
@if (_pending is not null)
{
    var remaining = _pending.ExpiresAt - Time.GetUtcNow();
    var expired = remaining <= TimeSpan.Zero;
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-warning">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirm-title">
                        <i class="bi bi-exclamation-triangle-fill text-warning" aria-hidden="true"></i> Conferma movimento del robot
                    </h5>
                </div>
                <div class="modal-body">
                    <p class="fw-semibold">@_pending.Summary</p>
                    <p class="small mb-1">Il robot si muoverà. Verifica che la cella di lavoro sia libera e che il pulsante di emergenza fisico sia a portata di mano.</p>
                    <p class="small text-muted mb-0">
                        @(expired ? "Conferma scaduta: chiudi e richiedi di nuovo." : $"Scade tra {Math.Ceiling(remaining.TotalSeconds):0} s.")
                    </p>
                </div>
                <div class="modal-footer justify-content-between">
                    @* STOP stays reachable while the dialog covers the page. *@
                    <StopButton Source="operator-confirm-dialog" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary" @onclick="CancelPending">Annulla</button>
                        <button class="btn btn-warning" disabled="@(expired || _busy)" @onclick="ConfirmPending">
                            <i class="bi bi-play-fill" aria-hidden="true"></i> Conferma e muovi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private const string Source = "operator-page";
    private static readonly TimeSpan RefreshPeriod = TimeSpan.FromMilliseconds(200);

    private RobotCommandService? _commands;
    private ScanService? _scanner;
    private RobotSnapshot _snapshot = RobotSnapshot.Initial;
    private DateOnly _today;
    private IReadOnlyList<ProductionOrder> _orders = []; // today's orders, done or to do
    private IReadOnlyList<Job> _jobs = [];

    // Selection comes only from a scanned (or typed) code: a plan row, or a service job (e.g. HOME).
    private int? _selectedOrderId;
    private string? _serviceCode;
    private ProductionOrder? _selectedOrder;
    private Job? _selectedJob;
    private string? _selectionMessage;

    private ElementReference _scanInput;
    private ElementReference _warningOk;
    private string _scanText = "";
    private string? _scanWarning;
    private bool _focusScan = true;
    private bool _focusWarning;

    private ConfirmationRequest? _pending;
    private bool _busy;
    private string? _lastResult;
    private bool _lastResultOk;
    private readonly CancellationTokenSource _cts = new();
    private Task? _refreshLoop;
    private int _tick;

    protected override async Task OnInitializedAsync()
    {
        _commands = Services.GetService<RobotCommandService>();
        _scanner = Services.GetService<ScanService>();
        _snapshot = Store.Current;
        await LoadPlanningAsync();
        _refreshLoop = RefreshLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            // The warning popup takes the focus, so the next Enter of the scanner (or keyboard) closes it.
            if (_focusWarning && _scanWarning is not null)
            {
                _focusWarning = false;
                await _warningOk.FocusAsync();
            }
            // Keyboard-wedge scanners type into the focused field: keep the scan box focused when idle.
            else if (_focusScan && _commands is not null && _pending is null && _scanWarning is null)
            {
                _focusScan = false;
                await _scanInput.FocusAsync();
            }
        }
        catch (Exception) { /* element not rendered yet */ }
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(RefreshPeriod);
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                var current = Store.Current;
                var cycleEnded = _snapshot.ActiveCycle is not null && current.ActiveCycle is null;
                var changed = current.Sequence != _snapshot.Sequence;
                _snapshot = current;
                // Planning data changes on the remote host and after each cycle: reload once a second.
                if (cycleEnded || ++_tick % 5 == 0)
                {
                    await LoadPlanningAsync();
                    _focusScan |= cycleEnded;
                }
                if (changed || _pending is not null || cycleEnded)
                    await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadPlanningAsync()
    {
        _today = WorkDay.Today(Time);
        // Only today's work, done or to do: cancelled orders and orders moved to another day stay visible
        // on the planning station only.
        _orders = (await Planning.ListPlanAsync(_today, _cts.Token))
            .Where(o => o.Status is OrderStatus.Pending or OrderStatus.Active or OrderStatus.Completed)
            .ToList();
        _jobs = await Planning.ListJobsAsync(_cts.Token);
        ResolveSelection();
    }

    /// <summary>Re-reads the selected row and its job (both may have been edited remotely or completed).</summary>
    private void ResolveSelection()
    {
        if (_serviceCode is { } code)
        {
            _selectedOrder = null;
            _selectedJob = _jobs.FirstOrDefault(j => j.ProductCode == code && j.Enabled && j.IsService);
            if (_selectedJob is null)
                (_serviceCode, _selectionMessage) = (null, $"Il codice '{code}' non è più disponibile: leggilo di nuovo.");
            return;
        }
        if (_selectedOrderId is not { } id)
        {
            (_selectedOrder, _selectedJob) = (null, null);
            return;
        }

        var row = _orders.FirstOrDefault(o => o.Id == id);
        if (row is not { IsOpen: true })
        {
            // Row completed (or cancelled): move to the next open row of the same code, if any.
            var rowCode = row?.ProductCode ?? _selectedOrder?.ProductCode;
            row = _orders.FirstOrDefault(o => o.IsOpen && o.ProductCode == rowCode);
            if (row is null)
            {
                (_selectedOrderId, _selectedOrder, _selectedJob) = (null, null, null);
                _selectionMessage = rowCode is null ? null : $"'{rowCode}' completato per oggi: leggi il codice successivo.";
                return;
            }
            _selectedOrderId = row.Id;
        }
        _selectedOrder = row;
        _selectedJob = _jobs.FirstOrDefault(j => j.ProductCode == row.ProductCode && j.Enabled);
        if (_selectedJob is null)
        {
            (_selectedOrderId, _selectedOrder) = (null, null);
            _selectionMessage = $"Il codice '{row.ProductCode}' manca o non è attivo: chiedi alla pianificazione.";
        }
    }

    private async Task OnScanSubmitAsync()
    {
        var raw = _scanText;
        _scanText = "";
        _focusScan = true;
        if (string.IsNullOrWhiteSpace(raw) || _scanner is null) return;

        if (_snapshot.ActiveCycle is not null || _pending is not null)
        {
            _scanner.LogIgnored(raw, "a cycle is running or awaiting confirmation", Source);
            ShowScanWarning("C'è un ciclo in corso: il codice è stato ignorato.");
            return;
        }

        var result = await _scanner.ResolveAsync(raw, Source);
        if (!result.IsValid)
        {
            ShowScanWarning(result.Error!);
            return;
        }
        (_selectedOrderId, _serviceCode, _selectionMessage) = (result.Order?.Id, result.Order is null ? result.Code : null, null);
        _lastResult = null;
        await LoadPlanningAsync();
    }

    private void ShowScanWarning(string message)
    {
        _scanWarning = message;
        _focusWarning = true;
    }

    private void CloseScanWarning()
    {
        _scanWarning = null;
        _focusScan = true;
    }

    private bool Allowed(RobotCommand command) => CommandPolicy.Check(_snapshot.State, command) is null;

    private string StartHint(RobotSnapshot s, bool running, bool onRobot, bool repeat) =>
        running ? "Lavorazione in corso. STOP ferma subito il robot."
        : _selectedJob is null ? "Leggi un codice per abilitare START."
        : !onRobot ? $"Il plan {_selectedJob.PlanName} non è salvato su questo robot: START è disattivato."
        : s.State != RobotServiceState.Operational ? $"START richiede lo stato PRONTO (ora {RobotStateStyle.Label(s.State)})."
        : repeat ? $"Pronto: START esegue il prossimo pezzo di {_selectedJob.ProductCode}."
        : "Pronto: START chiede conferma prima del primo pezzo.";

    private async Task StartAsync()
    {
        if (_commands is null || _selectedJob is null) return;
        _busy = true;
        try
        {
            if (_selectedOrder is { } order && _commands.CanRepeatWithoutConfirmation(order.Id))
            {
                Show(await _commands.StartNextCycleAsync(order.Id, Source));
                return;
            }
            var request = await _commands.RequestStartAsync(_selectedJob.ProductCode, _selectedOrder?.Id, Source);
            if (request.IsAccepted)
                _pending = request;
            else
                Show(CommandResult.Rejected(request.Rejection!));
        }
        finally
        {
            _busy = false;
            _focusScan = _pending is null;
        }
    }

    private async Task StopAsync()
    {
        if (_commands is null) return;
        // Not gated by _busy: STOP must never wait for another command of this page.
        Show(await _commands.StopAsync(Source));
        _focusScan = true;
    }

    private async Task Run(Func<RobotCommandService, Task<CommandResult>> action)
    {
        if (_commands is null) return;
        _busy = true;
        try { Show(await action(_commands)); }
        finally
        {
            _busy = false;
            _focusScan = true; // a clicked button took the focus: give it back to the scanner
        }
    }

    private async Task ConfirmPending()
    {
        if (_commands is null || _pending?.Token is not { } token) return;
        _busy = true;
        try
        {
            _pending = null;
            Show(await _commands.ConfirmAsync(token, Source));
        }
        finally
        {
            _busy = false;
            _focusScan = true;
        }
    }

    private void CancelPending()
    {
        if (_pending?.Token is { } token)
            _commands?.CancelConfirmation(token, Source);
        _pending = null;
        _focusScan = true;
    }

    private void Show(CommandResult result)
    {
        _lastResultOk = result.IsSuccess;
        _lastResult = result.IsSuccess ? "Comando accettato." : $"Comando non eseguito ({Labels.Of(result.Outcome)}): {result.Message}";
    }

    private static string StatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "Da fare",
        OrderStatus.Active => "In corso",
        OrderStatus.Completed => "Fatto",
        OrderStatus.Cancelled => "Annullato",
        _ => "Spostato a un altro giorno",
    };

    private static string StatusClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "text-bg-secondary",
        OrderStatus.Active => "text-bg-primary",
        OrderStatus.Completed => "text-bg-success",
        _ => "text-bg-dark",
    };

    public async ValueTask DisposeAsync()
    {
        if (_pending?.Token is { } token)
            _commands?.CancelConfirmation(token, Source);
        _cts.Cancel();
        if (_refreshLoop is not null)
            await _refreshLoop;
        _cts.Dispose();
    }
}
