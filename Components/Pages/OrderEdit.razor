@page "/orders/new"
@page "/orders/{Id:int}"
@attribute [Authorize(Policy = Policies.Planner)]
@inject IServiceProvider Services
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Nuovo ordine di produzione" : "Modifica ordine di produzione")</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@(Id is null ? "Nuovo ordine di produzione" : $"Ordine di produzione {_order?.Label}")</h1>
    <PlannerAccount />
</div>

@if (_planning is null)
{
    <div class="alert alert-info">Le modifiche si fanno solo dalla postazione remota di pianificazione.</div>
    return;
}
@if (Id is not null && _loaded && _order is not { Status: OrderStatus.Pending })
{
    <div class="alert alert-warning">
        @(_order is null ? "Ordine non trovato." : $"L'ordine {_order.Label} è {UiLabels.OrderStatusLabel(_order.Status)}: si possono modificare solo gli ordini non ancora iniziati.")
        <a href="@BackUrl">Torna agli ordini di produzione</a>
    </div>
    return;
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger">
        @foreach (var error in _errors)
        {
            <div>@error</div>
        }
    </div>
}

<div class="card" style="max-width: 40rem">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label" for="day">Giorno</label>
            <input id="day" type="date" class="form-control" style="max-width: 11rem" min="@(_today.ToString("yyyy-MM-dd"))" @bind="_date" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="code">Codice prodotto / lavoro</label>
            <select id="code" class="form-select" @bind="_code">
                <option value="">-- scegli --</option>
                @foreach (var job in _jobs.Where(j => !j.IsService))
                {
                    <option value="@job.ProductCode">@job.ProductCode → @job.PlanName @(job.Enabled ? "" : "(non attivo)")</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="quantity">Quantità (cicli)</label>
            <input id="quantity" type="number" min="1" max="@PlanningValidator.MaxQuantity" class="form-control" style="max-width: 10rem" @bind="_quantity" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="number">Numero ordine <span class="text-muted small">(facoltativo)</span></label>
            <input id="number" class="form-control" maxlength="@PlanningValidator.MaxOrderNumberLength" @bind="_number" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="notes">Note</label>
            <textarea id="notes" class="form-control" rows="2" maxlength="@PlanningValidator.MaxNotesLength" @bind="_notes"></textarea>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync"><i class="bi bi-save" aria-hidden="true"></i> Salva</button>
            <a class="btn btn-secondary" href="@BackUrl">Annulla</a>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    /// <summary>Day of a new row (yyyy-MM-dd); today when missing.</summary>
    [SupplyParameterFromQuery(Name = "date")] public DateOnly? Date { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PlanningService? _planning;
    private ProductionOrder? _order;
    private IReadOnlyList<Job> _jobs = [];
    private bool _loaded;
    private DateOnly _today;
    private DateOnly _date;
    private string _number = "";
    private string _code = "";
    private int _quantity = 1;
    private string? _notes;
    private IReadOnlyList<string> _errors = [];
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _planning = Services.GetService<PlanningService>();
        if (_planning is null) return;
        _today = _planning.Today;
        _date = Date is { } d && d >= _today ? d : _today;
        _jobs = await _planning.Reader.ListJobsAsync();
        if (Id is { } id)
        {
            _order = await _planning.Reader.GetOrderAsync(id);
            if (_order is not null)
                (_number, _code, _quantity, _notes, _date) = (_order.OrderNumber, _order.ProductCode, _order.Quantity, _order.Notes, _order.WorkDate);
        }
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var user = (await AuthState).User;
            var draft = new OrderDraft(_number, _code, _quantity, _notes, _date);
            var result = _order is null
                ? await _planning!.CreateOrderAsync(draft, user)
                : await _planning!.UpdateOrderAsync(_order.Id, _order.Version, draft, user);
            if (result.Success)
                Navigation.NavigateTo(BackUrl);
            else
                _errors = result.Errors;
        }
        finally { _busy = false; }
    }

    private string BackUrl => _date == _today || _date == default ? "orders" : $"orders?date={_date:yyyy-MM-dd}";
}
