@page "/jobs/new"
@page "/jobs/{Id:int}"
@attribute [Authorize(Policy = Policies.Planner)]
@inject IServiceProvider Services
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "Nuovo codice" : "Modifica codice")</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@(Id is null ? "Nuovo codice" : $"Codice {_job?.ProductCode}")</h1>
    <PlannerAccount />
</div>

@if (_planning is null)
{
    <div class="alert alert-info">Le modifiche si fanno solo dalla postazione remota di pianificazione.</div>
    return;
}
@if (Id is not null && _job is null && _loaded)
{
    <div class="alert alert-warning">Codice non trovato. <a href="jobs">Torna ai codici</a></div>
    return;
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger">
        @foreach (var error in _errors)
        {
            <div>@error</div>
        }
    </div>
}

<div class="card mb-3" style="max-width: 40rem">
    <div class="card-body">
        <div class="form-check mb-3">
            <input id="service" type="checkbox" class="form-check-input" @bind="_isService" />
            <label class="form-check-label" for="service">Codice di servizio (es. HOME): sempre disponibile all'operatore, non pianificato, non conteggiato</label>
        </div>
        <div class="mb-3">
            <label class="form-label" for="code">Codice articolo</label>
            @if (_isService || !_planning.OnlyImportedCodes)
            {
                <input id="code" class="form-control text-uppercase" maxlength="@ProductCode.MaxLength" @bind="_code" />
                <div class="form-text">
                    @(_isService ? "Codice di servizio: scritto a mano, non arriva dal gestionale." : "Codice libero (Erp:OnlyImportedCodes = false).")
                    Maiuscole e minuscole sono equivalenti. Il barcode deve contenere esattamente questo codice.
                </div>
            }
            else
            {
                <select id="code" class="form-select" @bind="_code">
                    <option value="">-- scegli un codice dal gestionale --</option>
                    @foreach (var article in _choices)
                    {
                        <option value="@article.Code">@article.RawCode</option>
                    }
                    @if (_job is not null && !_job.IsService && !_choices.Any(a => a.Code == _job.ProductCode))
                    {
                        <option value="@_job.ProductCode">@_job.ProductCode (non ricevuto dal gestionale)</option>
                    }
                </select>
                @if (_choices.Count == 0)
                {
                    <div class="form-text text-warning">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        Nessun codice articolo libero: tutti i codici ricevuti hanno già un programma. Attendi un nuovo file del
                        gestionale o usa "Verifica nuovo file" nella pagina <a href="jobs">Codici lavoro</a>.
                    </div>
                }
                else
                {
                    <div class="form-text">Solo i codici ricevuti dal gestionale che non hanno ancora un programma (@_choices.Count).</div>
                }
            }
        </div>
        <div class="mb-3">
            <label class="form-label" for="plan">Plan del robot</label>
            <select id="plan" class="form-select" @bind="_planName">
                <option value="">-- scegli --</option>
                @foreach (var plan in _planning.RobotPlans)
                {
                    <option value="@plan">@plan</option>
                }
                @if (!string.IsNullOrEmpty(_planName) && !_planning.RobotPlans.Contains(_planName))
                {
                    <option value="@_planName">@_planName (non presente sul robot)</option>
                }
            </select>
            @if (_planning.RobotPlans.Count == 0)
            {
                <div class="form-text text-warning">Elenco plan non disponibile: il robot non è ancora stato collegato.</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label" for="description">Descrizione</label>
            <input id="description" class="form-control" maxlength="@PlanningValidator.MaxDescriptionLength" @bind="_description" />
        </div>
        <div class="form-check mb-3">
            <input id="enabled" type="checkbox" class="form-check-input" @bind="_enabled" />
            <label class="form-check-label" for="enabled">Attivo (eseguibile dalla postazione operatore)</label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync"><i class="bi bi-save" aria-hidden="true"></i> Salva</button>
            <a class="btn btn-secondary" href="jobs">Annulla</a>
            @if (_job is not null)
            {
                @if (_confirmDelete)
                {
                    <button class="btn btn-danger ms-auto" disabled="@_busy" @onclick="DeleteAsync">Conferma eliminazione</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _confirmDelete = false">Mantieni</button>
                }
                else
                {
                    <button class="btn btn-outline-danger ms-auto" @onclick="() => _confirmDelete = true"><i class="bi bi-trash" aria-hidden="true"></i> Elimina</button>
                }
            }
        </div>
    </div>
</div>

@if (_history.Count > 0)
{
    <h2 class="h5">Storico</h2>
    <table class="table table-sm small" style="max-width: 40rem">
        <thead><tr><th>Versione</th><th>Azione</th><th>Utente</th><th>Quando</th></tr></thead>
        <tbody>
            @foreach (var h in _history)
            {
                <tr><td>v@(h.Version)</td><td>@h.Action</td><td>@h.User</td><td>@h.At.ToLocalTime().ToString("g")</td></tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public int? Id { get; set; }

    /// <summary>Pre-filled code, from the ERP codes list of the Jobs page.</summary>
    [SupplyParameterFromQuery(Name = "code")] public string? InitialCode { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PlanningService? _planning;
    private Job? _job;
    private bool _loaded;
    private string _code = "";
    private string _planName = "";
    private string? _description;
    private bool _enabled = true;
    private bool _isService;
    private IReadOnlyList<string> _errors = [];
    private IReadOnlyList<JobHistoryEntry> _history = [];
    private bool _busy;
    private bool _confirmDelete;
    private IReadOnlyList<ArticleCode> _choices = [];

    protected override async Task OnInitializedAsync()
    {
        _planning = Services.GetService<PlanningService>();
        if (_planning is null) return;
        if (Id is null && !string.IsNullOrWhiteSpace(InitialCode))
            _code = ProductCode.Normalize(InitialCode);
        if (Id is { } id)
        {
            _job = await _planning.Reader.GetJobAsync(id);
            if (_job is not null)
            {
                (_code, _planName, _description, _enabled, _isService) = (_job.ProductCode, _job.PlanName, _job.Description, _job.Enabled, _job.IsService);
                _history = await _planning.Reader.GetJobHistoryAsync(id);
            }
        }
        _choices = await _planning.ListAssignableArticlesAsync(_job?.ProductCode);
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var user = (await AuthState).User;
            var draft = new JobDraft(_code, _planName, _description, _enabled, _isService);
            var result = _job is null
                ? await _planning!.CreateJobAsync(draft, user)
                : await _planning!.UpdateJobAsync(_job.Id, _job.Version, draft, user);
            if (result.Success)
                Navigation.NavigateTo("jobs");
            else
                _errors = result.Errors;
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            var result = await _planning!.DeleteJobAsync(_job!.Id, _job.Version, (await AuthState).User);
            if (result.Success)
                Navigation.NavigateTo("jobs");
            else
                (_errors, _confirmDelete) = (result.Errors, false);
        }
        finally { _busy = false; }
    }
}
