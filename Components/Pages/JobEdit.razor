@page "/jobs/new"
@page "/jobs/{Id:int}"
@attribute [Authorize(Policy = Policies.Planner)]
@inject IServiceProvider Services
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "New job" : "Edit job")</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">@(Id is null ? "New job" : $"Job {_job?.ProductCode}")</h1>
    <PlannerAccount />
</div>

@if (_planning is null)
{
    <div class="alert alert-info">Editing is available on the remote planning station only.</div>
    return;
}
@if (Id is not null && _job is null && _loaded)
{
    <div class="alert alert-warning">Job not found. <a href="jobs">Back to jobs</a></div>
    return;
}

@if (_errors.Count > 0)
{
    <div class="alert alert-danger">
        @foreach (var error in _errors)
        {
            <div>@error</div>
        }
    </div>
}

<div class="card mb-3" style="max-width: 40rem">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label" for="code">Product / job code</label>
            <input id="code" class="form-control text-uppercase" maxlength="@ProductCode.MaxLength" @bind="_code" />
            <div class="form-text">Case-insensitive. The barcode must contain exactly this code.</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="plan">Robot plan</label>
            <select id="plan" class="form-select" @bind="_planName">
                <option value="">-- choose --</option>
                @foreach (var plan in _planning.RobotPlans)
                {
                    <option value="@plan">@plan</option>
                }
                @if (!string.IsNullOrEmpty(_planName) && !_planning.RobotPlans.Contains(_planName))
                {
                    <option value="@_planName">@_planName (not on robot)</option>
                }
            </select>
            @if (_planning.RobotPlans.Count == 0)
            {
                <div class="form-text text-warning">Robot plan list not available: the robot has not been connected yet.</div>
            }
        </div>
        <div class="mb-3">
            <label class="form-label" for="velocity">Velocity % (max @_planning.MaxVelocityScale)</label>
            <input id="velocity" type="number" class="form-control" min="1" max="@_planning.MaxVelocityScale" style="max-width: 8rem" @bind="_velocity" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="description">Description</label>
            <input id="description" class="form-control" maxlength="@PlanningValidator.MaxDescriptionLength" @bind="_description" />
        </div>
        <div class="form-check mb-3">
            <input id="enabled" type="checkbox" class="form-check-input" @bind="_enabled" />
            <label class="form-check-label" for="enabled">Enabled (can be run locally)</label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync"><i class="bi bi-save" aria-hidden="true"></i> Save</button>
            <a class="btn btn-secondary" href="jobs">Cancel</a>
            @if (_job is not null)
            {
                @if (_confirmDelete)
                {
                    <button class="btn btn-danger ms-auto" disabled="@_busy" @onclick="DeleteAsync">Confirm delete</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _confirmDelete = false">Keep</button>
                }
                else
                {
                    <button class="btn btn-outline-danger ms-auto" @onclick="() => _confirmDelete = true"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                }
            }
        </div>
    </div>
</div>

@if (_history.Count > 0)
{
    <h2 class="h5">History</h2>
    <table class="table table-sm small" style="max-width: 40rem">
        <thead><tr><th>Version</th><th>Action</th><th>By</th><th>When</th></tr></thead>
        <tbody>
            @foreach (var h in _history)
            {
                <tr><td>v@(h.Version)</td><td>@h.Action</td><td>@h.User</td><td>@h.At.ToLocalTime().ToString("g")</td></tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public int? Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PlanningService? _planning;
    private Job? _job;
    private bool _loaded;
    private string _code = "";
    private string _planName = "";
    private int _velocity = 50;
    private string? _description;
    private bool _enabled = true;
    private IReadOnlyList<string> _errors = [];
    private IReadOnlyList<JobHistoryEntry> _history = [];
    private bool _busy;
    private bool _confirmDelete;

    protected override async Task OnInitializedAsync()
    {
        _planning = Services.GetService<PlanningService>();
        if (_planning is null) return;
        _velocity = Math.Min(_velocity, _planning.MaxVelocityScale);
        if (Id is { } id)
        {
            _job = await _planning.Reader.GetJobAsync(id);
            if (_job is not null)
            {
                (_code, _planName, _velocity, _description, _enabled) = (_job.ProductCode, _job.PlanName, _job.VelocityScale, _job.Description, _job.Enabled);
                _history = await _planning.Reader.GetJobHistoryAsync(id);
            }
        }
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var user = (await AuthState).User;
            var draft = new JobDraft(_code, _planName, _velocity, _description, _enabled);
            var result = _job is null
                ? await _planning!.CreateJobAsync(draft, user)
                : await _planning!.UpdateJobAsync(_job.Id, _job.Version, draft, user);
            if (result.Success)
                Navigation.NavigateTo("jobs");
            else
                _errors = result.Errors;
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        try
        {
            var result = await _planning!.DeleteJobAsync(_job!.Id, _job.Version, (await AuthState).User);
            if (result.Success)
                Navigation.NavigateTo("jobs");
            else
                (_errors, _confirmDelete) = (result.Errors, false);
        }
        finally { _busy = false; }
    }
}
