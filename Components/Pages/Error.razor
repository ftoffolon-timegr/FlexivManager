@page "/Error"
@using System.Diagnostics

<PageTitle>Errore</PageTitle>

<h1 class="text-danger">Errore.</h1>
<h2 class="text-danger">Si è verificato un errore durante l'elaborazione della richiesta.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID richiesta:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modalità sviluppo</h3>
<p>
    Passando all'ambiente <strong>Development</strong> vengono mostrati più dettagli sull'errore.
</p>
<p>
    <strong>L'ambiente Development non va attivato sull'applicazione installata in produzione.</strong>
    Potrebbe mostrare agli utenti informazioni riservate contenute nelle eccezioni.
    Per il debug in locale, attiva l'ambiente <strong>Development</strong> impostando la variabile d'ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> a <strong>Development</strong>
    e riavvia l'applicazione.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
