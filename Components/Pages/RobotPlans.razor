@page "/plans"
@implements IAsyncDisposable
@inject SnapshotStore Store
@inject IPlanningReader Planning

<PageTitle>Robot plans</PageTitle>

<h1>Robot plans</h1>
<p class="text-muted small">
    Plans stored on the robot (Flexiv Elements), as read by the gateway. The list is refreshed periodically while the robot is idle.
</p>

@if (_plans.Length == 0)
{
    <div class="alert alert-secondary">No plan list yet: the robot has not been connected.</div>
}
else
{
    <table class="table table-sm align-middle">
        <thead><tr><th>Plan</th><th>Used by codes</th></tr></thead>
        <tbody>
            @foreach (var plan in _plans)
            {
                var codes = _jobs.Where(j => j.PlanName == plan).ToList();
                <tr>
                    <td><code>@plan</code></td>
                    <td>
                        @if (codes.Count == 0)
                        {
                            <span class="text-muted">-</span>
                        }
                        @foreach (var job in codes)
                        {
                            <span class="badge @(job.Enabled ? "text-bg-primary" : "text-bg-secondary") me-1">@job.ProductCode</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@{
    var orphans = _jobs.Where(j => _plans.Length > 0 && !_plans.Contains(j.PlanName)).ToList();
}
@if (orphans.Count > 0)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        Codes pointing to plans not on the robot:
        @foreach (var job in orphans)
        {
            <span class="badge text-bg-warning me-1">@job.ProductCode → @job.PlanName</span>
        }
    </div>
}

@code {
    private System.Collections.Immutable.ImmutableArray<string> _plans = [];
    private IReadOnlyList<Job> _jobs = [];
    private readonly CancellationTokenSource _cts = new();
    private Task? _loop;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loop = LoopAsync();
    }

    private async Task LoadAsync()
    {
        _plans = Store.Current.AvailablePlans;
        _jobs = await Planning.ListJobsAsync(_cts.Token);
    }

    private async Task LoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_loop is not null) await _loop;
        _cts.Dispose();
    }
}
