@page "/plans"
@implements IAsyncDisposable
@inject SnapshotStore Store
@inject IPlanningReader Planning

<PageTitle>Plan del robot</PageTitle>

<h1>Plan del robot</h1>
<p class="text-muted small">
    Plan salvati sul robot (Flexiv Elements), come letti dal gateway. L'elenco si aggiorna periodicamente quando il robot è fermo.
</p>

@if (_plans.Length == 0)
{
    <div class="alert alert-secondary">Elenco plan non ancora disponibile: il robot non è stato collegato.</div>
}
else
{
    <table class="table table-sm align-middle">
        <thead><tr><th>Plan</th><th>Usato dai codici</th></tr></thead>
        <tbody>
            @foreach (var plan in _plans)
            {
                var codes = _jobs.Where(j => j.PlanName == plan).ToList();
                <tr>
                    <td><code>@plan</code></td>
                    <td>
                        @if (codes.Count == 0)
                        {
                            <span class="text-muted">-</span>
                        }
                        @foreach (var job in codes)
                        {
                            <span class="badge @(job.Enabled ? "text-bg-primary" : "text-bg-secondary") me-1">@job.ProductCode</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@{
    var orphans = _jobs.Where(j => _plans.Length > 0 && !_plans.Contains(j.PlanName)).ToList();
}
@if (orphans.Count > 0)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        Codici che puntano a plan non presenti sul robot:
        @foreach (var job in orphans)
        {
            <span class="badge text-bg-warning me-1">@job.ProductCode → @job.PlanName</span>
        }
    </div>
}

@code {
    private System.Collections.Immutable.ImmutableArray<string> _plans = [];
    private IReadOnlyList<Job> _jobs = [];
    private readonly CancellationTokenSource _cts = new();
    private Task? _loop;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loop = LoopAsync();
    }

    private async Task LoadAsync()
    {
        _plans = Store.Current.AvailablePlans;
        _jobs = await Planning.ListJobsAsync(_cts.Token);
    }

    private async Task LoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_loop is not null) await _loop;
        _cts.Dispose();
    }
}
