{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "FlexivManager",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "FlexivManager.csproj", "--launch-profile", "http"],
      "port": 8081
    },
    {
      "name": "FlexivManager-robot",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "FlexivManager.csproj", "--launch-profile", "http", "--",
                      "--Robot:Backend=Flexiv", "--Robot:Flexiv:NetworkInterfaces:0=192.168.2.150", "--Robot:Flexiv:Verbose=true"],
      "port": 8081
    }
  ]
}
