{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosts": {
    "Operator": {
      "Address": "127.0.0.1",
      "Port": 8081
    },
    "Monitoring": {
      "Enabled": true,
      "Address": "127.0.0.1",
      "Port": 8080
    }
  },
  "Robot": {
    "PollRateHz": 50,
    "AutoConnect": true,
    "ReconnectInterval": "00:00:03",
    "DefaultCommandTimeout": "00:00:05",
    "ConfirmationTimeout": "00:00:15",
    "CatalogPath": "programs.json",
    "Mock": {
      "EnableDelay": "00:00:01.5"
    }
  }
}
