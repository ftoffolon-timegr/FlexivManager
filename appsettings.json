{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosts": {
    "Operator": {
      "Address": "127.0.0.1",
      "Port": 8081
    },
    "Monitoring": {
      "Enabled": true,
      "Address": "127.0.0.1",
      "Port": 8080,
      "RequireLoginForEdit": true,
      "Editor": {
        "UserName": "planner",
        // Generate with: FlexivManager.exe hash-password <password>. Empty = planning read-only.
        "PasswordHash": ""
      }
    }
  },
  "Planning": {
    "DatabasePath": "data/planning.db",
    "SeedDemoData": false
  },
  "Robot": {
    // Mock = simulator (default). Flexiv = real robot: set it only with the PC on the robot network
    // and RDK enabled on the robot (Flexiv Elements). No motion and no enable are ever started automatically.
    "Backend": "Mock",
    "Flexiv": {
      // First test robot: Rizon 4, robot software 3.10.3 -> RDK 1.8. Control box Hesper-062978.
      "SerialNumber": "Rizon4-062609",
      "RdkVersion": "1.8",
      "NetworkInterfaces": [],
      "ClearFaultTimeoutSeconds": 3,
      "Verbose": false
    },
    "PollRateHz": 50,
    "AutoConnect": true,
    "ReconnectInterval": "00:00:03",
    "DefaultCommandTimeout": "00:00:05",
    "ConfirmationTimeout": "00:00:15",
    "MaxVelocityScale": 100,
    "PlanStartTimeout": "00:00:05",
    "PlanListRefreshInterval": "00:00:10",
    "Mock": {
      "EnableDelay": "00:00:01.5"
    }
  }
}
