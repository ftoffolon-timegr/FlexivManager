{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hosts": {
    "Operator": {
      "Address": "127.0.0.1",
      "Port": 8081
    },
    "Monitoring": {
      "Enabled": true,
      "Address": "127.0.0.1",
      "Port": 8080,
      "RequireLoginForEdit": true,
      "Editor": {
        "UserName": "planner",
        // Generate with: FlexivManager.exe hash-password <password>. Empty = planning read-only.
        "PasswordHash": ""
      },
      "Api": {
        // Key for the REST write API, sent in the X-Api-Key header. Empty = write API disabled.
        // Use a long random value and keep it out of source control (environment variable
        // Hosts__Monitoring__Api__Key or a local appsettings file). Reading (GET /api/...) stays open.
        "Key": "",
        "ClientName": "api"
      }
    }
  },
  "Planning": {
    "DatabasePath": "data/planning.db",
    "SeedDemoData": false
  },
  "Erp": {
    // Article code files written by the customer's ERP (one code per line). Each file is deleted once its
    // codes are stored: the deletion tells the ERP the codes were loaded. Production data goes back through
    // GET /api/erp/production. See docs/INTEGRAZIONE-GESTIONALE.md.
    // Shared folder of the ERP (to be provided), e.g. "\\\\server\\share\\flexiv": the account running the
    // gateway needs read, write and delete rights there. A relative path is a local folder (created if missing).
    "Enabled": true,
    "ImportFolder": "data/erp-import",
    "FilePattern": "*.txt",
    "PollInterval": "00:01:00",
    "MinFileAge": "00:00:05",
    "DeleteAfterImport": true,
    // Code editor: a job may only use an article code received from the ERP (service codes like HOME excepted).
    "OnlyImportedCodes": true
  },
  "Robot": {
    // Mock = simulator (default). Flexiv = real robot: set it only with the PC on the robot network
    // and RDK enabled on the robot (Flexiv Elements). No motion and no enable are ever started automatically.
    "Backend": "Mock",
    "Flexiv": {
      // First test robot: Rizon 4, robot software 3.10.3 -> RDK 1.8. Control box Hesper-062978.
      //      "SerialNumber": "Rizon4-062609",
      "SerialNumber": "Rizon10-062596",
      // Name of the folder native\rdk-<version>: 3.10.x -> 1.8, 3.11.1 -> 1.9.2, 3.11.3 -> 1.9.4.1. Must match the robot software.
//      "RdkVersion": "1.8",
      "RdkVersion": "1.9.2",
      "NetworkInterfaces": ["192.168.6.150"],
      "ClearFaultTimeoutSeconds": 3,
      "Verbose": false
    },
    "PollRateHz": 50,
    "AutoConnect": true,
    "ReconnectInterval": "00:00:03",
    "DefaultCommandTimeout": "00:00:05",
    "ConfirmationTimeout": "00:00:15",
    "PlanStartTimeout": "00:00:05",
    "PlanListRefreshInterval": "00:00:10",
    "Mock": {
      "EnableDelay": "00:00:01.5"
    }
  }
}
